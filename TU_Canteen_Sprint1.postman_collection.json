    {
      "name": "2. User Story 4: Vendor Authentication (Phone + PIN)",
      "item": [
        {
          "name": "2.1 U4: ล็อกอินแม่ค้าสำเร็จ (ป้าณี 0811111111 / PIN 1111)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Token is returned\", function () {",
                  "    pm.expect(jsonData.token).to.be.a(\"string\");",
                  "    pm.collectionVariables.set(\"vendorToken\", jsonData.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"0811111111\",\n  \"pin\": \"1111\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "2.2 U4: ล็อกอินแม่ค้ากรณี PIN ผิด (Negative Test 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"0811111111\",\n  \"pin\": \"0000\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "2.3 U4: Route Guard: ตรวจสอบ Session ด้วย Bearer Token (/api/auth/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{vendorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. User Story 5: Toggle Shop Open/Closed Status",
      "item": [
        {
          "name": "3.1 U5: แม่ค้าเปลี่ยนสถานะเป็น ปิดร้าน (isOpen: false)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{vendorToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isOpen\": false,\n  \"statusNote\": \"ของหมด ปิดร้านชั่วคราว\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/shops/shop-green-01/status",
              "host": [
