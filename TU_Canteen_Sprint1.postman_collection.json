{
  "info": {
    "_postman_id": "tu-canteen-sprint1-collection",
    "name": "TU Canteen WebApp - Sprint 1 API Tests",
    "description": "Postman Collection สำหรับทดสอบ API ทั้งหมดใน Sprint 1 (CS261 Group 2) ครอบคลุมทั้งฝั่ง User, Merchant และ Admin",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "ownerToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Healthcheck & System Info",
      "item": [
        {
          "name": "Healthcheck API",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          }
        },
        {
          "name": "Get All Canteens",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/canteens",
              "host": ["{{baseUrl}}"],
              "path": ["api", "canteens"]
            }
          }
        },
        {
          "name": "Get All Food Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"]
            }
          }
        }
      ]
    },
    {
      "name": "1. User Story 2 & 3: Search & Filter (User)",
      "item": [
        {
          "name": "Search: ค้นหาร้านทั้งหมด",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/restaurants/search",
              "host": ["{{baseUrl}}"],
              "path": ["api", "restaurants", "search"]
            }
          }
        },
        {
          "name": "Search: กรองเฉพาะโรงอาหารกรีนแคนทีน",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/restaurants/search?canteen=GREEN_CANTEEN",
              "host": ["{{baseUrl}}"],
              "path": ["api", "restaurants", "search"],
              "query": [
                { "key": "canteen", "value": "GREEN_CANTEEN" }
              ]
            }
          }
        },
        {
          "name": "Search: กรองเฉพาะโรงอาหารคณะวิทยาศาสตร์",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/restaurants/search?canteen=SCIENCE_FACULTY",
              "host": ["{{baseUrl}}"],
              "path": ["api", "restaurants", "search"],
              "query": [
                { "key": "canteen", "value": "SCIENCE_FACULTY" }
              ]
            }
          }
        },
        {
          "name": "Search: กรองเฉพาะร้านที่เปิดอยู่ (status=OPEN)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/restaurants/search?status=OPEN",
              "host": ["{{baseUrl}}"],
              "path": ["api", "restaurants", "search"],
              "query": [
                { "key": "status", "value": "OPEN" }
              ]
            }
          }
        },
        {
          "name": "Search: ค้นหาตามชื่ออาหาร (กะเพรา)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/restaurants/search?q=กะเพรา",
              "host": ["{{baseUrl}}"],
              "path": ["api", "restaurants", "search"],
              "query": [
                { "key": "q", "value": "กะเพรา" }
              ]
            }
          }
        },
        {
          "name": "Search: กรองหมวดหมู่อาหาร (ก๋วยเตี๋ยว)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/restaurants/search?category=ก๋วยเตี๋ยว",
              "host": ["{{baseUrl}}"],
              "path": ["api", "restaurants", "search"],
              "query": [
                { "key": "category", "value": "ก๋วยเตี๋ยว" }
              ]
            }
          }
        },
        {
          "name": "Detail: ดูข้อมูลร้านและเมนู (ID: 1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/restaurants/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "restaurants", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "2. User Story 4: Authentication (Merchant Login)",
      "item": [
        {
          "name": "Login แม่ค้าสำเร็จ (ป้าศรี ข้าวแกง 0812345678 / PIN 1234)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('ownerToken', jsonData.token);",
                  "    console.log('Saved owner token:', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"0812345678\",\n  \"pin\": \"1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/owner/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "owner", "login"]
            }
          }
        },
        {
          "name": "Login แม่ค้า: กรณีใส่ PIN ผิด (Negative Test 401)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"0812345678\",\n  \"pin\": \"0000\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/owner/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "owner", "login"]
            }
          }
        },
        {
          "name": "Route Guard: ตรวจสอบ Session ด้วย Token (/api/auth/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "Logout เจ้าของร้าน",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "3. User Story 5 & 6: Merchant Store Management",
      "item": [
        {
          "name": "Toggle สถานะร้านเป็น CLOSED (ปิดร้าน)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CLOSED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/restaurants/1/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "restaurants", "1", "status"]
            }
          }
        },
        {
          "name": "Toggle สถานะร้านเป็น OPEN (เปิดร้าน)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"OPEN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/restaurants/1/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "restaurants", "1", "status"]
            }
          }
        },
        {
          "name": "ปรับปรุงเวลาเปิด - ปิดร้าน",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"openTime\": \"06:30\",\n  \"closeTime\": \"16:30\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/restaurants/1/hours",
              "host": ["{{baseUrl}}"],
              "path": ["api", "restaurants", "1", "hours"]
            }
          }
        },
        {
          "name": "สลับสถานะเมนูอาหารว่าหมดหรือไม่ (Sold Out)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isSoldOut\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/101/soldout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "101", "soldout"]
            }
          }
        },
        {
          "name": "เพิ่มเมนูอาหารใหม่เข้าร้าน",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"แกงเผ็ดเป็ดย่างพิเศษ\",\n  \"price\": 60\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/restaurants/1/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "restaurants", "1", "products"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Reviews (No Login Required)",
      "item": [
        {
          "name": "ส่งรีวิวร้านอาหาร (ไม่ต้องล็อกอิน)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"เด็กหอโซนบี\",\n  \"rating\": 5,\n  \"comment\": \"ข้าวแกงป้าศรีอร่อยมาก ให้กับข้าวเยอะ รสจัดจ้านโดนใจครับ!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/restaurants/1/reviews",
              "host": ["{{baseUrl}}"],
              "path": ["api", "restaurants", "1", "reviews"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Admin Portal",
      "item": [
        {
          "name": "แอดมินเพิ่มร้านอาหารใหม่ในโรงอาหาร",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"ข้าวมันไก่ตอน สูตรพิเศษ มธ.\",\n  \"canteenCode\": \"GREEN_CANTEEN\",\n  \"stallNumber\": \"ล็อค 15\",\n  \"category\": \"ข้าวมันไก่ / ข้าวหมูกรอบ\",\n  \"openTime\": \"07:00\",\n  \"closeTime\": \"15:00\",\n  \"initialOwnerPhone\": \"0891234567\",\n  \"initialOwnerPin\": \"1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/restaurants",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "restaurants"]
            }
          }
        }
      ]
    }
  ]
}
