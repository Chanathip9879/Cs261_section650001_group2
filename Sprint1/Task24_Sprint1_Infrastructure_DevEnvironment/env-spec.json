{
  "project": "TU Canteen Food Status WebApp",
  "organization": "Thammasat University - CS261 Group 2 Section 650001",
  "sprint": 1,
  "environment": "development",
  "specifications": {
    "nodeVersion": ">=18.0.0",
    "javaVersion": "21",
    "defaultAppPort": 3000,
    "springBootPort": 8080,
    "database": {
      "devType": "embedded-sqlite/in-memory",
      "integrationType": "mssql-server-2022",
      "port": 1433
    },
    "features": {
      "gpsLocationTracking": false,
      "canteenSelectorPreset": true,
      "noLoginUserReview": true,
      "merchantPhonePinAuth": true,
      "openCloseToggle": true,
      "outOfStockToggle": true
    }
  }
}
